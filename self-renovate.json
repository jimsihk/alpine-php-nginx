{
  "extends": ["github>jimsihk/alpine-php-nginx:renovate"],
  "onboarding": false,
  "requireConfig": "optional",
  "branchPrefixOld": "selfrenovate/",
  "branchPrefix": "selfrenovate/",
  "baseBranchPatterns": ["/^feature\\/alpine-upgrade.*/"],
  "includePaths": [
    "Dockerfile"
  ],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "commitMessagePrefix": "[SelfRenovate] ",
  "repositories": [
    "jimsihk/alpine-php-nginx"
  ]
}
